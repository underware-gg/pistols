{
  "name": "@underware/pistols-at-dawn",
  "version": "1.3.12",
  "description": "Pistols at Dawn JS client",
  "homepage": "https://github.com/underware-gg/pistols",
  "author": "Underware",
  "license": "CC0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "devs": "vite -c vite_https.config",
    "prebuild": "npx tsx scripts/generateAssetManifest.ts",
    "build": "npx tsc -p tsconfig.json && vite build",
    "sync": "npx tsc -watch",
    "check-types": "npx tsc --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-constants": "npx --package=@underware/pistols-sdk generate-constants --src:\"../dojo/src\" --out:\"$npm_config_sdk/generated/constants.ts\"",
    "generate-controller-preset": "npx --package=@underware/pistols-sdk generate-controller-preset --chain_id:\"$npm_config_chain_id\" --out:\"$npm_config_sdk/generated/preset.json\""
  },
  "keywords": [
    "pistols at dawn",
    "pistols at 10 blocks",
    "underware",
    "dojo",
    "typescript",
    "client"
  ],
  "dependencies": {
    "@cartridge/connector": "catalog:",
    "@cartridge/controller": "catalog:",
    "@dojoengine/core": "catalog:",
    "@dojoengine/sdk": "catalog:",
    "@dojoengine/torii-client": "catalog:",
    "@dojoengine/utils": "catalog:",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "7.3.2",
    "@starknet-io/get-starknet-core": "catalog:",
    "@starknet-react/chains": "catalog:",
    "@starknet-react/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tweenjs/tween.js": "21.1.1",
    "@underware/pistols-sdk": "workspace:*",
    "canvas-confetti": "1.9.4",
    "dexie": "4.2.0",
    "dexie-react-hooks": "1.1.7",
    "event-emitter": "0.3.5",
    "get-starknet-core": "4.0.0",
    "immer": "catalog:",
    "lil-gui": "0.19.2",
    "react": "catalog:",
    "react-circular-progressbar": "2.2.0",
    "react-cookie": "6.1.3",
    "react-dom": "catalog:",
    "react-router": "7.18.2",
    "semantic-ui-css": "2.5.0",
    "semantic-ui-react": "3.0.0-beta.2",
    "starknet": "catalog:",
    "starknetid.js": "catalog:",
    "three": "0.180.0",
    "type-fest": "2.19.0",
    "universal-cookie": "catalog:",
    "use-local-storage-state": "19.5.0",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.5.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@effect/platform": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "0.180.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "happy-dom": "20.11.2",
    "sass": "1.93.2",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vite": "6.4.3",
    "vite-plugin-glsl": "1.5.3",
    "vite-plugin-mkcert": "1.17.9",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
